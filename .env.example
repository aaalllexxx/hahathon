APP_NAME=CodeGuardian AI
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me

DATABASE_URL=sqlite:///./codeguardian.db

GITLAB_EXTERNAL_URL=http://localhost:8080
GITLAB_URL=http://localhost:8080
GITLAB_INTERNAL_URL=http://gitlab
GITLAB_PRIVATE_TOKEN=change-me
GITLAB_WEBHOOK_SECRET=super-secret-token
GITLAB_WEB_PORT=8080
GITLAB_SSH_PORT=2222
CODEGUARDIAN_WEBHOOK_URL=http://codeguardian:8000/webhooks/gitlab

OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=change-me
OPENAI_MODEL=qwen2.5-coder-32b-instruct
OPENAI_TIMEOUT=60
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=900

SECURITY_BLOCK_ON_CRITICAL=true
SECURITY_BLOCK_ON_HIGH=true
SECURITY_USE_LLM=true
SECURITY_REQUIRE_LLM_REVIEW=true
SECURITY_FAIL_CLOSED_ON_LLM_ERROR=true
SECURITY_MAX_DIFF_CHARS=60000
SECURITY_BLOCK_MERGE_REQUESTS=true
SECURITY_BLOCK_CLOSE_MR=true
SECURITY_BLOCK_INLINE_COMMENTS=true
SECURITY_BLOCK_PUSHES=false
SECURITY_BLOCK_PRE_RECEIVE=false
SECURITY_PRECHECK_PUBLIC=true
CODEGUARDIAN_PUBLIC_URL=http://localhost:8000

CVE_ENABLE=true
CVE_OSV_API_URL=https://api.osv.dev
CVE_TIMEOUT=10
CVE_MAX_DEPENDENCIES=20

DASHBOARD_TITLE=CodeGuardian AI
LOG_LEVEL=INFO
