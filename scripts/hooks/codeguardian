#!/usr/bin/env bash
# CodeGuardian AI server-side pre-receive hook for GitLab.
# Hardcoded defaults for docker-compose deployment.

set -uo pipefail

API="${CODEGUARDIAN_API:-http://codeguardian:8000}"
TOKEN="${CODEGUARDIAN_API_TOKEN:-super-secret-token}"
STRICT="${CODEGUARDIAN_STRICT:-1}"

ZERO="0000000000000000000000000000000000000000"

block_reason=""
while read -r OLD NEW REF; do
  if [ "$NEW" = "$ZERO" ]; then
    continue
  fi

  if [ "$OLD" = "$ZERO" ]; then
    BASE=$(git for-each-ref --format='%(objectname)' refs/heads/main refs/heads/master 2>/dev/null | head -n1)
    if [ -z "$BASE" ] || [ "$BASE" = "$NEW" ]; then
      DIFF=$(git show --unified=3 "$NEW" 2>/dev/null || true)
    else
      DIFF=$(git diff --unified=3 "$BASE..$NEW" 2>/dev/null || true)
    fi
  else
    DIFF=$(git diff --unified=3 "$OLD..$NEW" 2>/dev/null || true)
  fi

  if [ -z "$DIFF" ]; then
    continue
  fi

  TMP=$(mktemp)
  python3 - "$DIFF" >"$TMP" <<'PY'
import json, sys, os
diff = sys.argv[1]
print(json.dumps({
  "diff": diff,
  "origin": "pre-receive",
  "repository": os.environ.get("GL_PROJECT_PATH") or os.environ.get("GL_REPOSITORY") or "unknown",
  "branch": (os.environ.get("GL_REF") or "").replace("refs/heads/", "") or None,
  "commit_sha": os.environ.get("GL_NEW_REV"),
  "author": os.environ.get("GL_USERNAME"),
}))
PY

  HTTP_CODE=$(
    curl -sS -o /tmp/cg_resp.json -w "%{http_code}" \
      -X POST \
      -H "Content-Type: application/json" \
      ${TOKEN:+-H "X-CodeGuardian-Token: $TOKEN"} \
      --data-binary @"$TMP" \
      "$API/api/git/precheck" 2>/dev/null || echo "000"
  )
  rm -f "$TMP"

  if [ "$HTTP_CODE" = "422" ]; then
    echo "" >&2
    echo "✖ CodeGuardian AI rejected push to $REF" >&2
    python3 -c "
import json
try:
  d=json.load(open('/tmp/cg_resp.json'))
  b=d.get('detail',d)
  print(b.get('block_message') or '')
  for f in (b.get('findings') or []):
    print(f'- [{f.get(\"severity\")}] {f.get(\"cwe\")} {f.get(\"title\")} @ {f.get(\"file\")}:{f.get(\"line\")}')
except: pass
" >&2
    block_reason="blocked"
  elif [ "$HTTP_CODE" = "000" ] || [ "$HTTP_CODE" = "" ]; then
    echo "[CodeGuardian] WARNING: API unavailable ($API)." >&2
    if [ "$STRICT" = "1" ]; then
      block_reason="api-down"
    fi
  elif [ "$HTTP_CODE" != "200" ]; then
    echo "[CodeGuardian] WARNING: unexpected HTTP $HTTP_CODE from API." >&2
    if [ "$STRICT" = "1" ]; then
      block_reason="api-error"
    fi
  fi
done

if [ -n "$block_reason" ]; then
  exit 1
fi
exit 0
